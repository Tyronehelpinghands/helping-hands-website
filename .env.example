# Publieke site-URL (SEO canonical / sitemap / OG)
NEXT_PUBLIC_SITE_URL=https://helpinghandsagency.nl

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Demo-portalen (UI)
# Default: aan. Zet op false om demo_role cookies te weigeren.
ALLOW_DEMO_ACCESS=true

# Demo-integratie-API’s (Shiftbase / HubSpot / Moneybird / Maps)
# Default: uit. Zet alleen op true in vertrouwde demo/staging.
# Zonder deze flag blokkeert requireInternApiAccess demo_role=internal.
ALLOW_DEMO_API_ACCESS=false

# Server-only integraties (nooit NEXT_PUBLIC_)
# SHIFTBASE_API_KEY=
# HUBSPOT_ACCESS_TOKEN=
# MONEYBIRD_API_TOKEN=
# GOOGLE_MAPS_API_KEY=
