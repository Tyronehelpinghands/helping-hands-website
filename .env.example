# Public site URL used for canonical, Open Graph and sitemap absolute URLs.
# Set per environment (local / preview / production). No trailing slash.
# Example production: https://helpinghandsagency.nl
# Example Vercel preview: https://helping-hands-website.vercel.app
NEXT_PUBLIC_SITE_URL=https://helpinghandsagency.nl

# Supabase Auth (public anon key only — never service role as NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Demo UI / API gates (production: leave API access false)
ALLOW_DEMO_ACCESS=true
ALLOW_DEMO_API_ACCESS=false

# --- Existing integrations (server-only) ---
# SHIFTBASE_API_TOKEN=
# SHIFTBASE_API_BASE_URL=
# MONEYBIRD_ACCESS_TOKEN=
# MONEYBIRD_ADMINISTRATION_ID=
# HUBSPOT_ACCESS_TOKEN=
# GOOGLE_MAPS_API_KEY=

# --- WhatsApp Cloud API (server-only, never NEXT_PUBLIC_*) ---
# wa.me works without these via siteConfig.phoneTel
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Gmail API OAuth (server-only, never NEXT_PUBLIC_*) ---
# mailto works without these via siteConfig mailboxes
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GMAIL_SENDER=planning@helpinghandsagency.nl

# --- Contact form via Resend (server-only, never NEXT_PUBLIC_*) ---
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=Helping Hands Agency <noreply@helpinghandsagency.nl>
# STAFF_REQUEST_TO_EMAIL=planning@helpinghandsagency.nl
# CREW_APPLICATION_TO_EMAIL=aanmeldingen@helpinghandsagency.nl
# GENERAL_CONTACT_TO_EMAIL=info@helpinghandsagency.nl
